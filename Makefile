IntanRHX.app/Contents/PkgInfo: 
	@test -d IntanRHX.app/Contents || mkdir -p IntanRHX.app/Contents
	@$(DEL_FILE) IntanRHX.app/Contents/PkgInfo
	@echo "APPL????" > IntanRHX.app/Contents/PkgInfo
IntanRHX.app/Contents/Info.plist: 
	@test -d IntanRHX.app/Contents || mkdir -p IntanRHX.app/Contents
	@$(DEL_FILE) IntanRHX.app/Contents/Info.plist
	@set -o pipefail && plutil -convert xml1 -o - /opt/homebrew/share/qt/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.IntanRHX,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.IntanRHX,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},14.0,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,IntanRHX,g" -e "s,@LIBRARY@,IntanRHX,g" -e "s,\$${EXECUTABLE_NAME},IntanRHX,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >IntanRHX.app/Contents/Info.plist

all: Makefile \
		IntanRHX.app/Contents/PkgInfo \
		IntanRHX.app/Contents/Info.plist IntanRHX.app/Contents/MacOS/IntanRHX

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

